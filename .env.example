PORT=8000
BASE_URL=http://localhost:8000
LOG_LEVEL=info
CACHE_TTL=3600
CACHE_DB_PATH=data/cache.db
TMDB_API_KEY=   # opcional: cadastro gratuito em themoviedb.org

# Fontes ativas
ENABLE_APACHE_TORRENT=true
ENABLE_COMANDO_FILMES=true
ENABLE_BRAZUCA=true
ENABLE_YTS=true
ENABLE_ARCHIVE_ORG=true

# Fontes com domínio instável (o circuit breaker pausa falhas repetidas)
ENABLE_HDR_TORRENT=true
ENABLE_MICOLEAO=true

# Fontes sujeitas a anti-bot, login ou troca de domínio
ENABLE_TORRENT_GALAXY=true
ENABLE_1337X=true
ENABLE_RUTRACKER=true
